{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Database IDE",
  "version": "0.1.0",
  "identifier": "com.oakko.database-ide",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [{
      "title": "Database IDE",
      "width": 1180,
      "height": 760,
      "minWidth": 760,
      "minHeight": 560,
      "resizable": true
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.svg"]
  }
}
